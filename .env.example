# Gemini TTS. Get a key at https://aistudio.google.com/apikey
# Copy this file to .env — it is read by the dev server only and never
# reaches the browser.
GEMINI_API_KEY=
# Optional: override the TTS model.
# GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview

# ElevenLabs TTS. Get a key at https://elevenlabs.io/app/settings/api-keys
# Free tier: 10,000 characters a month, personal use, credit ElevenLabs.
ELEVENLABS_API_KEY=
# Optional: eleven_flash_v2_5 is half a credit per character, and less good.
# ELEVENLABS_MODEL=eleven_multilingual_v2
