# Gemini TTS. Get a key at https://aistudio.google.com/apikey
# Copy this file to .env — it is read by the dev server only and never
# reaches the browser.
GEMINI_API_KEY=
# Optional: override the models. The defaults are aliases, so they track
# whatever Google ships next rather than pinning to a name that ages out.
# GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
# GEMINI_SCRIPT_MODEL=gemini-flash-latest

# ElevenLabs TTS. Get a key at https://elevenlabs.io/app/settings/api-keys
# Free tier: 10,000 characters a month, personal use, credit ElevenLabs.
ELEVENLABS_API_KEY=
# Optional: eleven_flash_v2_5 is half a credit per character, and less good.
# ELEVENLABS_MODEL=eleven_multilingual_v2

# Mistral Voxtral TTS. Get a key at https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
# MISTRAL_TTS_MODEL=voxtral-mini-tts-2603
